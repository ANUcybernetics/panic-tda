[Unit]
Description=PANIC-TDA long experiment %i (bin/long-run)
Documentation=file:///home/ben/projects/panic_tda/bin/long-run

[Service]
Type=simple
WorkingDirectory=/home/ben/projects/panic_tda
Environment=PATH=/home/ben/.local/share/mise/shims:/home/ben/.local/bin:/usr/local/bin:/usr/bin:/bin
# the instance name is the config's: panic-experiment@x runs config/x.json
ExecStart=/home/ben/projects/panic_tda/bin/long-run config/%i.json
# bin/long-run exits 0 only once the experiment is complete; anything else
# (crash, OOM, reboot) comes back here after a minute.
Restart=on-failure
RestartSec=60
# a Python interpreter shutdown can take a while; don't SIGKILL it early
TimeoutStopSec=300
# the run is GPU-bound, so yield CPU and disk to the machine's other jobs;
# CPUWeight is what arbitrates between service cgroups, Nice only within one
Nice=10
CPUWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=default.target
